#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig SYSTEM_IMU
	tristate "ICM-20948 IMU Test Application"
	default n
	depends on SPI
	---help---
		Enable the ICM-20948 9-axis IMU test application for J722S / AM67A.

if SYSTEM_IMU

config SYSTEM_IMU_PROGNAME
	string "Program name"
	default "imu"
	---help---
		This is the name of the program that will be used in the shell.

config SYSTEM_IMU_PRIORITY
	int "IMU task priority"
	default 100

config SYSTEM_IMU_STACKSIZE
	int "IMU stack size"
	default 2048

endif
