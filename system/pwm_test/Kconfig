#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig SYSTEM_PWM_TEST
	tristate "AM67A ePWM Motor Test Application"
	default y
	---help---
		Enable the AM67A ePWM Motor test application for testing
		multi-channel ESC/servo PWM signals (frequency, pulse width, sweep).

if SYSTEM_PWM_TEST

config SYSTEM_PWM_TEST_PROGNAME
	string "Program name"
	default "pwm_test"
	---help---
		This is the name of the program that will be used in the shell.

config SYSTEM_PWM_TEST_PRIORITY
	int "PWM test task priority"
	default 100

config SYSTEM_PWM_TEST_STACKSIZE
	int "PWM test stack size"
	default 2048

endif
