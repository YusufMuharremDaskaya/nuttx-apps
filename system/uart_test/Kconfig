#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig SYSTEM_UART_TEST
	tristate "T3-GEM-O1 UART Test Application"
	default y
	---help---
		Enable multi-port diagnostic utility for all UART interfaces on T3-GEM-O1
		(/dev/ttyS0, /dev/ttyS1, /dev/ttyS2, /dev/ttyS3).

if SYSTEM_UART_TEST

config SYSTEM_UART_TEST_PROGNAME
	string "Program name"
	default "uart_test"
	---help---
		This is the name of the program that will be used in the shell.

config SYSTEM_UART_TEST_PRIORITY
	int "UART test task priority"
	default 100

config SYSTEM_UART_TEST_STACKSIZE
	int "UART test stack size"
	default 4096

endif
